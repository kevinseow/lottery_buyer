# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_telegram_chat_id

# TOTO Rule Configuration
JACKPOT_THRESHOLD=2000000
CHECK_INTERVAL_HOURS=24

# Singapore Pools Credentials (keep local & private)
SGPOOLS_USERNAME=your_singapore_pools_username
SGPOOLS_PASSWORD=your_singapore_pools_password

# Browser Settings (true for silent background, false for visible testing window)
HEADLESS_MODE=true
